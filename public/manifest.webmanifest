{
  "id": "/",
  "name": "MVPEAV",
  "short_name": "MVPEAV",
  "description": "College football simulation slates, edges and live scoreboards.",
  "start_url": "/cfb/scoreboard",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b2d4b",
  "theme_color": "#0b2d4b",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://www.mvpeav.com/manifest.webmanifest"
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
